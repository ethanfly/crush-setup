{
  "name": "crush-setup",
  "version": "1.0.0",
  "description": "Desktop manager for Crush models, skills, MCP, and every crushrc/schema config family",
  "main": "electron/main.js",
  "productName": "Crush Setup",
  "author": "ethanfly",
  "bin": {
    "crush-setup": "bin/crush-setup.js"
  },
  "scripts": {
    "start": "electron .",
    "desktop": "node bin/crush-setup.js",
    "test": "node --test test/persist.test.js",
    "probe": "node test/persist-probe.js",
    "self-check": "node bin/crush-setup.js --self-check",
    "version:next": "node scripts/next-version.js",
    "dist": "electron-builder --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:linux": "electron-builder --linux --publish never"
  },
  "build": {
    "appId": "land.crush.setup",
    "productName": "Crush Setup",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "ui/**/*",
      "assets/**/*",
      "bin/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Crush Setup"
    },
    "mac": {
      "icon": "assets/icon.png",
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "linux": {
      "icon": "assets/icon.png",
      "category": "Development",
      "target": [
        "AppImage"
      ]
    }
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3"
  }
}
